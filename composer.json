{
  "name": "witalijkaa/models-alpha",
  "description": "Base models for PHP",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "nesbot/carbon": "^3",
    "ext-mbstring": "*",
    "ext-ctype": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "ModelsAlpha\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ModelsAlpha\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
